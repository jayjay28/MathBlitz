# CloudKit Web Services key ID from Apple Developer → Keys
CK_KEY_ID=7b989704ef93598dcb02ee55b37dfe2b97afba4b34748927c6c30cac063cbd2c

# iCloud container ID (e.g., iCloud.MathBlitz)
CK_CONTAINER_ID=iCloud.MathBlitz

# Environment: development or production
CK_ENV=development

